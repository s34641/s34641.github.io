<!DOCTYPE html>
<html lang="th" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เกี่ยวกับฉัน - Praew Portfolio</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Prompt', sans-serif; background-color: #f0f7ff; } /* โทนพื้นหลังฟ้าพาสเทลอ่อนๆ */
        .pastel-pattern {
            background-image: radial-gradient(#bae6fd 1px, transparent 1px), radial-gradient(#fbcfe8 1px, #f0f7ff 1px);
            background-size: 24px 24px; background-position: 0 0, 12px 12px; opacity: 0.4;
        }
    </style>
</head>
<body class="text-slate-700 relative">
    <div class="absolute inset-0 pastel-pattern pointer-events-none fixed z-0"></div>

    <!-- เมนูด้านบนสุด (กดไปได้ทุกหน้า) -->
    <nav class="fixed top-0 left-0 w-full bg-white/90 backdrop-blur-md shadow-xs z-50 border-b border-pink-100">
        <div class="max-w-6xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="index.html" class="text-2xl font-bold text-pink-500 flex items-center gap-2"><span class="text-sky-400">💙</span> Praew Portfolio</a>
            <div class="hidden md:flex space-x-8 font-medium">
                <a href="index.html" class="hover:text-pink-500 transition">หน้าแรก</a>
                <a href="about.html" class="text-pink-500 font-semibold transition">เกี่ยวกับฉัน</a>
                <a href="performance.html" class="hover:text-pink-500 transition">ผลงาน</a>
                <a href="contact.html" class="hover:text-pink-500 transition">ติดต่อ</a>
            </div>
            <button id="menu-btn" class="md:hidden text-slate-700 focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b px-6 py-4 space-y-3">
            <a href="index.html" class="block hover:text-pink-500">หน้าแรก</a>
            <a href="about.html" class="block text-pink-500 font-semibold">เกี่ยวกับฉัน</a>
            <a href="performance.html" class="block hover:text-pink-500">ผลงาน</a>
            <a href="contact.html" class="block hover:text-pink-500">ติดต่อ</a>
        </div>
    </nav>

    <!-- เนื้อหาหน้า About -->
    <section class="py-32 relative z-10">
        <div class="max-w-4xl mx-auto px-6">

            <!-- 1. ที่ให้ใส่รูปภาพสไตล์วงกลม -->
            <div class="flex justify-center mb-8">
                <div class="relative w-44 h-44 md:w-52 md:h-52 rounded-full overflow-hidden border-4 border-pink-300 shadow-xl bg-white">
                    <!-- เปลี่ยนลิงก์รูปภาพใน src="..." เป็นรูปของคุณได้เลย -->
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80" alt="Praew Profile" class="w-full h-full object-cover">
                </div>
            </div>

            <!-- 2. มารู้จักกับดิฉันกันค่ะ 🙇🏻‍♀️ (สีชมพูเข้ม) -->
            <div class="text-center mb-6">
                <h2 class="text-2xl md:text-3xl font-bold text-pink-600">
                    มารู้จักกับดิฉันกันค่ะ 🙇🏻‍♀️
                </h2>
            </div>

            <!-- 3. ข้อมูลส่วนตัว (โรงเรียนและแผนการเรียน) -->
            <div class="bg-white/80 backdrop-blur-sm p-8 rounded-3xl shadow-sm border border-pink-100 text-center mb-12">
                <p class="text-lg md:text-xl font-semibold text-slate-800 mb-4">
                    ดิฉันชื่อ นางสาววราลี อาจชัยสงฆ์
                </p>
                <div class="space-y-2 text-slate-600 text-base md:text-lg">
                    <p>กำลังศึกษาอยู่ที่โรงเรียนบ้านบึง <span class="text-pink-600 font-medium">“อุตสาหกรรมนุเคราะห์”</span></p>
                    <p class="bg-pink-50 text-pink-700 py-1.5 px-4 rounded-xl inline-block text-sm font-medium border border-pink-100 mt-2">
                        ระดับมัธยมต้น 1-3 แผนการเรียนศิลปะ
                    </p>
                    <p class="bg-sky-50 text-sky-700 py-1.5 px-4 rounded-xl inline-block text-sm font-medium border border-sky-100 ml-0 md:ml-2 mt-2">
                        ระดับมัธยมปลาย 4-6 แผนการเรียนภาษาจีน
                    </p>
                </div>
            </div>

            <!-- 4. หัวข้อ: 🎓 มหาลัยที่สนใจ (มีกรอบสีชมพู) -->
            <div class="mb-12">
                <div class="border-2 border-pink-400 bg-pink-50/70 rounded-2xl p-6 text-center shadow-sm">
                    <h3 class="text-xl font-bold text-pink-600 mb-3 flex items-center justify-center gap-2">
                        <span>🎓</span> มหาลัยที่สนใจ
                    </h3>
                    <div class="space-y-1 text-slate-700 font-medium">
                        <p class="text-lg text-slate-800">มหาวิทยาลัยบูรพา</p>
                        <p>คณะมนุษยศาสตร์และสังคมศาสตร์</p>
                        <p class="text-pink-600 font-semibold">สาขาภาษาจีนเพื่อการสื่อสาร (รูปแบบที่ 1)</p>
                    </div>
                </div>
            </div>

            <!-- 5. หัวข้อ: 🗯️ ทักษะ (มีกรอบสีชมพู พร้อมช่องใส่รูป 5 ด้าน) -->
            <div class="mb-16">
                <div class="border-2 border-pink-400 bg-white/90 rounded-3xl p-6 md:p-8 shadow-sm">
                    <h3 class="text-xl font-bold text-pink-600 mb-8 text-center flex items-center justify-center gap-2">
                        <span>🗯️</span> ทักษะความสามารถ
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- ทักษะที่ 1 -->
                        <div class="flex items-center gap-4 bg-pink-50/50 p-4 rounded-2xl border border-pink-100">
                            <div class="w-16 h-16 rounded-full overflow-hidden bg-white border-2 border-pink-300 shrink-0 shadow-xs">
                                <!-- ช่องใส่รูปทักษะการร้องเพลง -->
                                <img src="https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=300&q=80" alt="Singing" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm md:text-base">ด้านการร้องเพลง</h4>
                                <p class="text-xs text-slate-500">ทักษะการแสดงออกทางดนตรี</p>
                            </div>
                        </div>

                        <!-- ทักษะที่ 2 -->
                        <div class="flex items-center gap-4 bg-pink-50/50 p-4 rounded-2xl border border-pink-100">
                            <div class="w-16 h-16 rounded-full overflow-hidden bg-white border-2 border-pink-300 shrink-0 shadow-xs">
                                <!-- ช่องใส่รูปทักษะการเป็นผู้นำ -->
                                <img src="https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=300&q=80" alt="Leadership" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm md:text-base">ด้านการเป็นผู้นำ</h4>
                                <p class="text-xs text-slate-500">การบริหารจัดการและทำงานร่วมกัน</p>
                            </div>
                        </div>

                        <!-- ทักษะที่ 3 -->
                        <div class="flex items-center gap-4 bg-pink-50/50 p-4 rounded-2xl border border-pink-100">
                            <div class="w-16 h-16 rounded-full overflow-hidden bg-white border-2 border-pink-300 shrink-0 shadow-xs">
                                <!-- ช่องใส่รูปทักษะภาษาจีน -->
                                <img src="https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?auto=format&fit=crop&w=300&q=80" alt="Chinese" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm md:text-base">ด้านภาษาจีน</h4>
                                <p class="text-xs text-slate-500">การสื่อสารและทักษะภาษา</p>
                            </div>
                        </div>

                        <!-- ทักษะที่ 4 -->
                        <div class="flex items-center gap-4 bg-pink-50/50 p-4 rounded-2xl border border-pink-100">
                            <div class="w-16 h-16 rounded-full overflow-hidden bg-white border-2 border-pink-300 shrink-0 shadow-xs">
                                <!-- ช่องใส่รูปทักษะการปฐมพยาบาล -->
                                <img src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=300&q=80" alt="First Aid" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm md:text-base">ด้านการปฐมพยาบาล</h4>
                                <p class="text-xs text-slate-500">การช่วยเหลือเบื้องต้นและความปลอดภัย</p>
                            </div>
                        </div>

                        <!-- ทักษะที่ 5 -->
                        <div class="flex items-center gap-4 bg-pink-50/50 p-4 rounded-2xl border border-pink-100 md:col-span-2 md:max-w-md md:mx-auto">
                            <div class="w-16 h-16 rounded-full overflow-hidden bg-white border-2 border-pink-300 shrink-0 shadow-xs">
                                <!-- ช่องใส่รูปทักษะการเข้าสังคม -->
                                <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=300&q=80" alt="Social Skills" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm md:text-base">ด้านการเข้าสังคม</h4>
                                <p class="text-xs text-slate-500">มนุษยสัมพันธ์และการสื่อสารกับผู้อื่น</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. ปุ่มลิงก์ไปหน้า performance.html (ผลงานและเกียรติบัตร) -->
            <div class="text-center">
                <a href="performance.html" class="inline-flex items-center gap-2 text-white font-semibold bg-pink-500 hover:bg-pink-600 px-8 py-4 rounded-full shadow-lg shadow-pink-200 transition">
                    ผลงานและเกียรติบัตร 📚 <span class="text-lg">&rarr;</span>
                </a>
            </div>

        </div>
    </section>

    <footer class="bg-slate-900 text-pink-200/70 py-8 text-center text-sm relative z-10 border-t border-slate-800">
        <p>&copy; 2026 Praew Portfolio. All rights reserved. 🌸</p>
    </footer>

    <script>
        const btn = document.getElementById('menu-btn');
        const menu = document.getElementById('mobile-menu');
        btn.addEventListener('click', () => { menu.classList.toggle('hidden'); });
    </script>
</body>
</html>
